<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.8"/>
  <object class="AdwShortcutsDialog" id="shortcuts_dialog">
    <child>
      <object class="AdwShortcutsSection">
        <property name="title">Navigation</property>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title">Select next item</property>
            <property name="accelerator">Down j</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title">Select previous item</property>
            <property name="accelerator">Up k</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwShortcutsSection">
        <property name="title">Actions</property>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title">Copy selected item</property>
            <property name="accelerator">Return</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title">Preview selected item</property>
            <property name="accelerator">space</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title">Enlarge / shrink preview</property>
            <property name="accelerator">plus minus</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title">Delete selected item</property>
            <property name="accelerator">Delete</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title">Clear all history</property>
            <property name="accelerator">&lt;Control&gt;&lt;Shift&gt;Delete</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwShortcutsSection">
        <property name="title">Search</property>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title">Search</property>
            <property name="accelerator">&lt;Control&gt;f slash</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title">Close search</property>
            <property name="accelerator">Escape</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwShortcutsSection">
        <property name="title">General</property>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title">Show this window</property>
            <property name="accelerator">question F1</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
